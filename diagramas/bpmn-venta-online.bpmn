      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Preparar_di" bpmnElement="T_Preparar">
        <dc:Bounds x="1340" y="410" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Enviar_di" bpmnElement="T_Enviar">
        <dc:Bounds x="1520" y="630" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Entregado_di" bpmnElement="End_Entregado">
        <dc:Bounds x="1702" y="652" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1680" y="692" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="298" y="230" /><di:waypoint x="340" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="450" y="230" /><di:waypoint x="500" y="230" />
      </bpmndi:BPMNEdge>
