        <di:waypoint x="525" y="255" /><di:waypoint x="525" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="531" y="268" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_StockSi_di" bpmnElement="F_StockSi">
        <di:waypoint x="550" y="230" /><di:waypoint x="600" y="230" />
        <bpmndi:BPMNLabel><dc:Bounds x="566" y="212" width="12" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="580" y="340" /><di:waypoint x="632" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="720" y="230" /><di:waypoint x="770" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SyncNo_di" bpmnElement="F_SyncNo">
        <di:waypoint x="795" y="255" /><di:waypoint x="795" y="340" /><di:waypoint x="860" y="340" />
        <bpmndi:BPMNLabel><dc:Bounds x="801" y="290" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Reintento_di" bpmnElement="F_Reintento">
        <di:waypoint x="970" y="340" /><di:waypoint x="1000" y="340" /><di:waypoint x="1000" y="175" /><di:waypoint x="640" y="175" /><di:waypoint x="640" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SyncSi_di" bpmnElement="F_SyncSi">
